# Copie para .env e preencha. docker-compose.yml lê estas variáveis.

# Obrigatório: o nome do seu PERFIL NO FUT.GG — não a gamertag da EA. Abra
# https://www.fut.gg/gg-club/ logado e copie o nome que aparece na URL (pode
# colar a URL inteira, ela é normalizada sozinha).
EAFC_GAMERTAG=

# Opcional: moedas extras a considerar no orçamento, além do saldo lido do
# clube (a Community API da EA não expõe saldo).
EAFC_BUDGET=0

# Opcional: fuso do container — o scheduler roda "daily_at" nesse horário.
TZ=America/Sao_Paulo

# Opcional: agente especialista em evoluções. O endpoint remoto precisa ser
# HTTPS (HTTP só é aceito para um agente em localhost).
# EAFC_EVO_AGENT_URL=https://seu-agente.example/analyze
# EAFC_EVO_AGENT_TOKEN=

# Opcional: host dentro do container. O binário nativo usa loopback por
# padrão; o compose usa 0.0.0.0 somente para atravessar a ponte publicada.
# EAFC_LISTEN_HOST=0.0.0.0

# --- Postgres (profile "postgres"), opcional ---
# Só preencha se for rodar `docker compose --profile postgres up -d --build`
# depois de ter rodado `go get github.com/jackc/pgx/v5` localmente.
# POSTGRES_PASSWORD=
# EAFC_DSN=postgres://eafc:MESMA_SENHA_ACIMA@postgres:5432/eafc?sslmode=disable
# BUILD_TAGS=postgres
